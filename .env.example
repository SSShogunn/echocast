# Copy this file to .env and fill in your values

# Required: your public HTTPS tunnel URL (ngrok, Cloudflare Tunnel, etc.)
BASE_URL=https://your-tunnel-url.example.com

# Optional: if your audio stream is served from a different URL than BASE_URL
# Defaults to BASE_URL if not set
# STREAM_BASE_URL=https://lan.your-domain.com

# Optional: port for the HTTP server (default: 3000)
# PORT=3000

# Optional: audio capture device name as shown in DirectShow (Windows)
# Run: ffmpeg -list_devices true -f dshow -i dummy  to list devices
# Default: CABLE Output (VB-Audio Virtual Cable)
# FFMPEG_DEVICE=CABLE Output (VB-Audio Virtual Cable)

# Optional: enable HTTPS server for local network streaming
# Path to your TLS cert folder (must contain fullchain.pem and privkey.pem)
# CERT_PATH=C:/Certbot/live/your-domain.com
# HTTPS_PORT=443
